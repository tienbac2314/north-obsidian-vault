filters:
  and:
    - 'file.inFolder("PARA/Areas")'
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: Area
  category:
    displayName: Category
  status:
    displayName: Status
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Active
    filters:
      and:
        - 'status != "archived"'
    order:
      - file.name
      - category
      - status
      - file.mtime
