filters:
  and:
    - 'file.ext == "md"'
    - or:
        - 'file.inFolder("STAGING/Pending Agent Review")'
        - 'file.inFolder("STAGING/Agent Proposals")'
        - 'file.inFolder("STAGING/Reviewed")'
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Stage
  status:
    displayName: Status
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Queue
    order:
      - file.name
      - file.folder
      - status
      - file.mtime
